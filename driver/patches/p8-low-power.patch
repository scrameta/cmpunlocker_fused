diff --git a/kernel-open/nvidia/nv-cmp-hbm.h b/kernel-open/nvidia/nv-cmp-hbm.h
new file mode 100644
index 0000000..f307c44
--- /dev/null
+++ b/kernel-open/nvidia/nv-cmp-hbm.h
@@ -0,0 +1,1015 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * GA100 / CMP 170HX HBM idle clock governor.
+ *
+ * Ported from Zagitta/gpu-unlock (kernel/gpu_unlock/hbm.h, hbm.c, hbm_work.c)
+ * including PR #373 hardening (stop_machine() CPU hold during FB-stop clock
+ * switches, bounded PLL lock polls, 5 s default idle delay, and 1 s retry
+ * backoff on switch errors).
+ */
+#ifndef NV_CMP_HBM_H
+#define NV_CMP_HBM_H
+
+#ifdef __KERNEL__
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/limits.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/pci.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+#include <linux/stop_machine.h>
+#include <linux/string.h>
+#include <linux/suspend.h>
+#include <linux/workqueue.h>
+#include <uapi/linux/pci_regs.h>
+#endif
+
+#define CMP_HBM_POLL_MS            20U
+#define CMP_HBM_RETRY_MS           1000U
+#define CMP_HBM_DEFAULT_IDLE_MS    5000U
+#define CMP_HBM_DEFAULT_MIN_CYCLES 8192U
+#define CMP_HBM_IDLE_NDIV          20U
+#define CMP_HBM_IDLE_PLDIV         1U
+#define CMP_HBM_IDLE_REFRESH       48U
+#define CMP_HBM_FB_MASK0           0x00000080U
+
+#define CMP_HBM_FBPA_BASE        0x00900000U
+#define CMP_HBM_FBPA_STRIDE      0x00004000U
+#define CMP_HBM_FBPA_CFG1        0x0204U
+#define CMP_HBM_REFRESH_PLM      0x0168U
+#define CMP_HBM_REFRESH          0x02a0U
+#define CMP_HBM_REFRESH_MASK     0x00007ff8U
+#define CMP_HBM_SOFTWARE_REF     0x0310U
+#define CMP_HBM_PLL_PLM          0x3c7cU
+#define CMP_HBM_PLL_CFG          0x3c90U
+#define CMP_HBM_PLL_COEFF        0x3c98U
+#define CMP_HBM_PLL_LOCK         0x20U
+#define CMP_HBM_PLL_BYPASS       0x400U
+#define CMP_HBM_NDIV_MASK        0xff00U
+#define CMP_HBM_PLDIV_MASK       0x3f0000U
+#define CMP_HBM_CLOCK_MASK       (CMP_HBM_NDIV_MASK | CMP_HBM_PLDIV_MASK)
+#define CMP_HBM_PLL_CFG_MC2      0x0098bc90U
+#define CMP_HBM_PLL_COEFF_MC2    0x0098bc98U
+#define CMP_HBM_PRI_FENCE        0x001211fcU
+#define CMP_HBM_FB_STOP_OUTPUT   0x0010a7c0U
+#define CMP_HBM_FB_STOP_INPUT    0x0010a7c4U
+#define CMP_HBM_FB_STOP_SET      0x0010a7e0U
+#define CMP_HBM_FB_STOP_CLEAR    0x0010a7e4U
+#define CMP_HBM_FB_STOP          (1U << 2)
+#define CMP_HBM_GFW_BOOT         0x00118234U
+#define CMP_HBM_GSP_RISCV_STATUS 0x00111240U
+#define CMP_HBM_PLM_HOST_WRITE   0x00000010U
+#define CMP_HBM_COUNT_MASK       0x7fffffffU
+/* Stay well below a 31-bit counter wrap even at the highest PMU clock. */
+#define CMP_HBM_MAX_SAMPLE_NS    1000000000ULL
+/* PLL locks within the first few settle reads; bound waits under stop_machine(). */
+#define CMP_HBM_SETTLE_READS     500U
+#define CMP_HBM_LOCK_POLLS       1000U
+
+enum cmp_hbm_mode {
+    CMP_HBM_AUTO = 0,
+    CMP_HBM_BUSY = 1,
+    CMP_HBM_IDLE = 2,
+};
+
+struct cmp_hbm_policy {
+    u32 ndiv, pldiv, refresh, idle_ms, min_cycles;
+    enum cmp_hbm_mode mode;
+};
+
+struct cmp_hbm_counter {
+    u32 mask[3], control, threshold, count, delta;
+};
+
+struct cmp_hbm {
+    struct cmp_hbm_policy policy;
+    struct cmp_hbm_counter counter[16];
+    u16 counters, active_counters;
+    u32 max_delta;
+    u32 fbpas, first_fbpa, busy_coeff, idle_coeff, busy_refresh[24];
+    u64 sampled, quiet_since;
+    bool profile, baseline, idle, fb_stopped;
+    const char *reason;
+    u32 reg, value, coverage[3];
+};
+
+static const u32 cmp_hbm_counter_addr[5] = {
+    0x0010be40U, 0x0010be80U, 0x0010bec0U, 0x0010bfc0U, 0x0010be00U,
+};
+
+/* GR, all nine copy engines, and framebuffer requests. */
+static const u32 cmp_hbm_required[3] = {
+    0x00380081U, 0x00700000U, 0x00000007U,
+};
+
+static bool cmp_hbm_readable(u32 value)
+{
+    return value != ~0U && (value & 0xfff00000U) != 0xbad00000U;
+}
+
+static int cmp_hbm_problem(struct cmp_hbm *hbm, int error, const char *reason,
+                           u32 reg, u32 value)
+{
+    hbm->reason = reason;
+    hbm->reg = reg;
+    hbm->value = value;
+    return error;
+}
+
+static bool cmp_hbm_booted(void __iomem *bar)
+{
+    u32 boot = readl(bar + CMP_HBM_GFW_BOOT);
+    u32 gsp  = readl(bar + CMP_HBM_GSP_RISCV_STATUS);
+
+    return cmp_hbm_readable(boot) && cmp_hbm_readable(gsp) &&
+           (boot & 0xffU) == 0xffU &&
+           ((gsp & 7U) == 3U || (gsp & 7U) == 5U);
+}
+
+static void cmp_hbm_init(struct cmp_hbm *hbm, u32 idle_ms)
+{
+    memset(hbm, 0, sizeof(*hbm));
+    hbm->policy.ndiv       = CMP_HBM_IDLE_NDIV;
+    hbm->policy.pldiv      = CMP_HBM_IDLE_PLDIV;
+    hbm->policy.refresh    = CMP_HBM_IDLE_REFRESH;
+    hbm->policy.idle_ms    = (idle_ms >= 100U) ? idle_ms : CMP_HBM_DEFAULT_IDLE_MS;
+    hbm->policy.min_cycles = CMP_HBM_DEFAULT_MIN_CYCLES;
+    hbm->policy.mode       = CMP_HBM_AUTO;
+}
+
+static void cmp_hbm_reset(struct cmp_hbm *hbm)
+{
+    hbm->baseline = false;
+    /* Keep the saved profile until idle settings and our stop are cleared. */
+    if (!hbm->idle && !hbm->fb_stopped)
+        hbm->profile = false;
+}
+
+static u32 cmp_hbm_fbpa(unsigned int index)
+{
+    return CMP_HBM_FBPA_BASE + index * CMP_HBM_FBPA_STRIDE;
+}
+
+static u32 cmp_hbm_idle_coeff(const struct cmp_hbm *hbm)
+{
+    return (hbm->busy_coeff & ~CMP_HBM_CLOCK_MASK) |
+           (hbm->policy.ndiv << 8) | (hbm->policy.pldiv << 16);
+}
+
+static int cmp_hbm_capture_profile(struct cmp_hbm *hbm, void __iomem *bar)
+{
+    u32 coeff, cfg, plm, mask = 0U, first = 0U;
+    unsigned int i;
+
+    for (i = 0; i < 24U; i++)
+    {
+        u32 base = cmp_hbm_fbpa(i);
+        u32 geometry = readl(bar + base + CMP_HBM_FBPA_CFG1);
+
+        if (!cmp_hbm_readable(geometry) || geometry == 0U)
+            continue;
+        plm = readl(bar + base + CMP_HBM_REFRESH_PLM);
+        if (!(plm & CMP_HBM_PLM_HOST_WRITE) || (plm & 0xfff00000U) == 0xbad00000U)
+            return cmp_hbm_problem(hbm, -EAGAIN, "refresh access closed",
+                                   base + CMP_HBM_REFRESH_PLM, plm);
+        hbm->busy_refresh[i] = readl(bar + base + CMP_HBM_REFRESH);
+        if (!cmp_hbm_readable(hbm->busy_refresh[i]) ||
+            !(hbm->busy_refresh[i] & CMP_HBM_REFRESH_MASK))
+            return cmp_hbm_problem(hbm, -EAGAIN, "invalid refresh",
+                                   base + CMP_HBM_REFRESH, hbm->busy_refresh[i]);
+        if (mask == 0U)
+            first = base;
+        mask |= 1U << i;
+    }
+    if (mask == 0U)
+        return cmp_hbm_problem(hbm, -EAGAIN, "no accessible memory controllers",
+                               CMP_HBM_FBPA_BASE + CMP_HBM_FBPA_CFG1, 0U);
+
+    cfg   = readl(bar + first + CMP_HBM_PLL_CFG);
+    coeff = readl(bar + first + CMP_HBM_PLL_COEFF);
+    plm   = readl(bar + first + CMP_HBM_PLL_PLM);
+    if (!cmp_hbm_readable(cfg) || (cfg & (CMP_HBM_PLL_LOCK | 1U)) != (CMP_HBM_PLL_LOCK | 1U) ||
+        (cfg & ((1U << 7) | (1U << 10))) != 0U)
+        return cmp_hbm_problem(hbm, -EAGAIN, "HBM PLL not ready",
+                               first + CMP_HBM_PLL_CFG, cfg);
+    if (!cmp_hbm_readable(coeff) || !(coeff & 0xffU) || !(coeff & 0x3f0000U))
+        return cmp_hbm_problem(hbm, -EAGAIN, "invalid HBM PLL coefficient",
+                               first + CMP_HBM_PLL_COEFF, coeff);
+    if (!(plm & CMP_HBM_PLM_HOST_WRITE) || (plm & 0xfff00000U) == 0xbad00000U)
+        return cmp_hbm_problem(hbm, -EAGAIN, "HBM PLL access closed",
+                               first + CMP_HBM_PLL_PLM, plm);
+
+    hbm->fbpas = mask;
+    hbm->first_fbpa = first;
+    hbm->busy_coeff = coeff;
+    hbm->idle_coeff = cmp_hbm_idle_coeff(hbm);
+    hbm->profile = true;
+    return 0;
+}
+
+/*
+ * Shorten refresh intervals before increasing the clock, lengthen them after
+ * decreasing it. Preserve every field outside the refresh interval.
+ */
+static int cmp_hbm_refresh(struct cmp_hbm *hbm, void __iomem *bar, bool idle, bool before)
+{
+    unsigned int i;
+
+    for (i = 0; i < 24U; i++)
+    {
+        u32 addr, value, target, old;
+
+        if (!(hbm->fbpas & (1U << i)))
+            continue;
+        addr = cmp_hbm_fbpa(i) + CMP_HBM_REFRESH;
+        value = readl(bar + addr);
+        if (!cmp_hbm_readable(value))
+            return cmp_hbm_problem(hbm, -EIO, "refresh read failed", addr, value);
+        old = value & CMP_HBM_REFRESH_MASK;
+        target = idle ? (hbm->policy.refresh << 3) : (hbm->busy_refresh[i] & CMP_HBM_REFRESH_MASK);
+        if (target == old || (target < old) != before)
+            continue;
+        writel((value & ~CMP_HBM_REFRESH_MASK) | target, bar + addr);
+        value = readl(bar + addr);
+        if (!cmp_hbm_readable(value) || (value & CMP_HBM_REFRESH_MASK) != target)
+            return cmp_hbm_problem(hbm, -EIO, "refresh readback mismatch", addr, value);
+    }
+    return 0;
+}
+
+/* MC2 addresses the VBIOS-configured serial-priv master group. */
+static void cmp_hbm_pll_write(void __iomem *bar, u32 reg, u32 value)
+{
+    writel(value, bar + reg);
+    writel(0U, bar + CMP_HBM_PRI_FENCE);
+    ndelay(20);
+}
+
+static int cmp_hbm_pll_wait(struct cmp_hbm *hbm, void __iomem *bar, u32 coeff,
+                            bool bypass, const char *phase)
+{
+    unsigned int i, poll;
+    u32 expected = CMP_HBM_PLL_LOCK | 1U | (bypass ? CMP_HBM_PLL_BYPASS : 0U);
+
+    for (i = 0; i < 24U; i++)
+    {
+        u32 reg = cmp_hbm_fbpa(i) + CMP_HBM_PLL_CFG;
+        u32 value = 0U;
+
+        if (!(hbm->fbpas & (1U << i)))
+            continue;
+        for (poll = 0; poll < CMP_HBM_LOCK_POLLS; poll++)
+        {
+            reg = cmp_hbm_fbpa(i) + CMP_HBM_PLL_CFG;
+            value = readl(bar + reg);
+            if (!cmp_hbm_readable(value) ||
+                (value & (CMP_HBM_PLL_LOCK | 1U | CMP_HBM_PLL_BYPASS | (1U << 7))) != expected)
+                continue;
+            reg = cmp_hbm_fbpa(i) + CMP_HBM_PLL_COEFF;
+            value = readl(bar + reg);
+            if (value == coeff)
+                break;
+        }
+        if (poll == CMP_HBM_LOCK_POLLS)
+            return cmp_hbm_problem(hbm, -ETIMEDOUT, phase, reg, value);
+    }
+    return 0;
+}
+
+static int cmp_hbm_set_clock(struct cmp_hbm *hbm, void __iomem *bar, bool idle)
+{
+    u32 old   = readl(bar + hbm->first_fbpa + CMP_HBM_PLL_COEFF);
+    u32 cfg   = readl(bar + hbm->first_fbpa + CMP_HBM_PLL_CFG);
+    u32 value = idle ? hbm->idle_coeff : hbm->busy_coeff;
+    bool bypass = ((old ^ value) & CMP_HBM_PLDIV_MASK) != 0U;
+    unsigned int i;
+    int ret;
+
+    if (old != hbm->busy_coeff && old != hbm->idle_coeff)
+        return cmp_hbm_problem(hbm, -EIO, "HBM PLL configuration changed",
+                               hbm->first_fbpa + CMP_HBM_PLL_COEFF, old);
+    if (!cmp_hbm_readable(cfg) ||
+        (cfg & (CMP_HBM_PLL_LOCK | 1U | CMP_HBM_PLL_BYPASS | (1U << 7))) != (CMP_HBM_PLL_LOCK | 1U))
+        return cmp_hbm_problem(hbm, -EIO, "HBM PLL not ready for transition",
+                               hbm->first_fbpa + CMP_HBM_PLL_CFG, cfg);
+    if (value == old)
+        return 0;
+
+    if (bypass)
+    {
+        cmp_hbm_pll_write(bar, CMP_HBM_PLL_CFG_MC2, cfg | CMP_HBM_PLL_BYPASS);
+        ret = cmp_hbm_pll_wait(hbm, bar, old, true, "HBM bypass entry timeout");
+        if (ret)
+            goto rollback;
+        udelay(2);
+    }
+    cmp_hbm_pll_write(bar, CMP_HBM_PLL_COEFF_MC2, value);
+    for (i = 0; i < CMP_HBM_SETTLE_READS; i++)
+        (void)readl(bar + hbm->first_fbpa + CMP_HBM_PLL_CFG);
+    ret = cmp_hbm_pll_wait(hbm, bar, value, bypass, "HBM PLL lock/coefficient timeout");
+    if (ret)
+        goto rollback;
+    if (bypass)
+    {
+        cmp_hbm_pll_write(bar, CMP_HBM_PLL_CFG_MC2, cfg);
+        udelay(2);
+        ret = cmp_hbm_pll_wait(hbm, bar, value, false, "HBM bypass exit timeout");
+        if (ret)
+            goto rollback;
+    }
+    return 0;
+
+rollback:
+    if (bypass)
+    {
+        cmp_hbm_pll_write(bar, CMP_HBM_PLL_CFG_MC2, cfg | CMP_HBM_PLL_BYPASS);
+        udelay(2);
+    }
+    cmp_hbm_pll_write(bar, CMP_HBM_PLL_COEFF_MC2, old);
+    for (i = 0; i < CMP_HBM_SETTLE_READS; i++)
+        (void)readl(bar + hbm->first_fbpa + CMP_HBM_PLL_CFG);
+    if (bypass)
+    {
+        cmp_hbm_pll_write(bar, CMP_HBM_PLL_CFG_MC2, cfg);
+        udelay(2);
+    }
+    return ret;
+}
+
+static int cmp_hbm_fb_wait(struct cmp_hbm *hbm, void __iomem *bar, bool stopped)
+{
+    u32 value = 0U;
+    unsigned int i;
+
+    for (i = 0; i < 1000U; i++)
+    {
+        value = readl(bar + CMP_HBM_FB_STOP_INPUT);
+        if (!cmp_hbm_readable(value))
+            return cmp_hbm_problem(hbm, -EIO, "HBM FB stop ACK unreadable",
+                                   CMP_HBM_FB_STOP_INPUT, value);
+        if (((value & CMP_HBM_FB_STOP) != 0U) == stopped)
+            return 0;
+        udelay(1);
+    }
+    return cmp_hbm_problem(hbm, -ETIMEDOUT,
+                           stopped ? "HBM FB stop ACK timeout" : "HBM FB resume ACK timeout",
+                           CMP_HBM_FB_STOP_INPUT, value);
+}
+
+static int cmp_hbm_fb_stop(struct cmp_hbm *hbm, void __iomem *bar)
+{
+    u32 request = readl(bar + CMP_HBM_FB_STOP_OUTPUT);
+    u32 ack     = readl(bar + CMP_HBM_FB_STOP_INPUT);
+
+    if (!cmp_hbm_readable(request) || !cmp_hbm_readable(ack))
+        return cmp_hbm_problem(hbm, -EIO, "HBM FB stop state unreadable",
+                               !cmp_hbm_readable(request) ? CMP_HBM_FB_STOP_OUTPUT : CMP_HBM_FB_STOP_INPUT,
+                               !cmp_hbm_readable(request) ? request : ack);
+    if (request & CMP_HBM_FB_STOP)
+    {
+        if (hbm->fb_stopped)
+            return cmp_hbm_fb_wait(hbm, bar, true);
+        return cmp_hbm_problem(hbm, -EBUSY, "HBM FB stop already owned",
+                               CMP_HBM_FB_STOP_OUTPUT, request);
+    }
+    if ((ack & CMP_HBM_FB_STOP) && !hbm->fb_stopped)
+        return cmp_hbm_problem(hbm, -EBUSY, "HBM FB stop ACK still set",
+                               CMP_HBM_FB_STOP_INPUT, ack);
+
+    hbm->fb_stopped = true;
+    writel(CMP_HBM_FB_STOP, bar + CMP_HBM_FB_STOP_SET);
+    request = readl(bar + CMP_HBM_FB_STOP_OUTPUT);
+    if (!cmp_hbm_readable(request) || !(request & CMP_HBM_FB_STOP))
+        return cmp_hbm_problem(hbm, -EIO, "HBM FB stop request did not latch",
+                               CMP_HBM_FB_STOP_OUTPUT, request);
+    return cmp_hbm_fb_wait(hbm, bar, true);
+}
+
+static int cmp_hbm_fb_start(struct cmp_hbm *hbm, void __iomem *bar)
+{
+    u32 request;
+    unsigned int i;
+    int ret;
+
+    for (i = 0; i < 24U; i++)
+    {
+        if (hbm->fbpas & (1U << i))
+            writel(1U, bar + cmp_hbm_fbpa(i) + CMP_HBM_SOFTWARE_REF);
+    }
+    writel(0U, bar + CMP_HBM_PRI_FENCE);
+    ndelay(20);
+    writel(CMP_HBM_FB_STOP, bar + CMP_HBM_FB_STOP_CLEAR);
+    request = readl(bar + CMP_HBM_FB_STOP_OUTPUT);
+    if (!cmp_hbm_readable(request) || (request & CMP_HBM_FB_STOP))
+        return cmp_hbm_problem(hbm, -EIO, "HBM FB resume request did not clear",
+                               CMP_HBM_FB_STOP_OUTPUT, request);
+    ret = cmp_hbm_fb_wait(hbm, bar, false);
+    if (!ret)
+        hbm->fb_stopped = false;
+    return ret;
+}
+
+struct cmp_hbm_switch {
+    struct cmp_hbm *hbm;
+    void __iomem *bar;
+    bool idle;
+};
+
+static int cmp_hbm_switch_profile(void *data)
+{
+    struct cmp_hbm_switch *work = (struct cmp_hbm_switch *)data;
+    struct cmp_hbm *hbm = work->hbm;
+    void __iomem *bar = work->bar;
+    bool idle = work->idle;
+    int ret = cmp_hbm_fb_stop(hbm, bar);
+    int resumed;
+
+    if (!ret)
+        ret = cmp_hbm_refresh(hbm, bar, idle, true);
+    if (!ret)
+        ret = cmp_hbm_set_clock(hbm, bar, idle);
+    if (!ret)
+        ret = cmp_hbm_refresh(hbm, bar, idle, false);
+    if (!hbm->fb_stopped)
+        return ret;
+    if (ret)
+    {
+        u32 coeff = readl(bar + hbm->first_fbpa + CMP_HBM_PLL_COEFF);
+        int ready;
+
+        if (coeff != hbm->busy_coeff && coeff != hbm->idle_coeff)
+            return cmp_hbm_problem(hbm, -EIO, "HBM FB resume blocked by unknown PLL",
+                                   hbm->first_fbpa + CMP_HBM_PLL_COEFF, coeff);
+        ready = cmp_hbm_pll_wait(hbm, bar, coeff, false,
+                                 "HBM FB resume blocked by PLL timeout");
+        if (ready)
+            return ready;
+    }
+    resumed = cmp_hbm_fb_start(hbm, bar);
+    return resumed ? resumed : ret;
+}
+
+/*
+ * Hold other CPUs during the ~2 ms FB-stop switch so concurrent host accesses
+ * cannot collide with the stopped framebuffer (Zagitta PR #373).
+ */
+static int cmp_hbm_transition(struct cmp_hbm *hbm, void __iomem *bar, bool idle)
+{
+    struct cmp_hbm_switch work = { .hbm = hbm, .bar = bar, .idle = idle };
+
+    return stop_machine(cmp_hbm_switch_profile, &work, NULL);
+}
+
+static int cmp_hbm_restore(struct cmp_hbm *hbm, void __iomem *bar)
+{
+    int ret;
+
+    if (!hbm->idle && !hbm->fb_stopped)
+        return 0;
+    if (!cmp_hbm_booted(bar))
+        return -EAGAIN;
+    ret = cmp_hbm_transition(hbm, bar, false);
+    if (!ret)
+        hbm->idle = false;
+    return ret;
+}
+
+static int cmp_hbm_enter_idle(struct cmp_hbm *hbm, void __iomem *bar)
+{
+    int ret;
+
+    if (((hbm->busy_coeff & CMP_HBM_NDIV_MASK) >> 8) * hbm->policy.pldiv <
+        hbm->policy.ndiv * ((hbm->busy_coeff & CMP_HBM_PLDIV_MASK) >> 16))
+        return cmp_hbm_problem(hbm, -EINVAL, "HBM idle target exceeds busy clock", 0U, 0U);
+
+    hbm->idle_coeff = cmp_hbm_idle_coeff(hbm);
+    hbm->idle = true;
+    ret = cmp_hbm_transition(hbm, bar, true);
+    if (ret)
+    {
+        (void)cmp_hbm_restore(hbm, bar);
+        hbm->baseline = false;
+    }
+    return ret;
+}
+
+static bool cmp_hbm_read_counter(struct cmp_hbm *hbm, void __iomem *bar,
+                                 unsigned int slot, struct cmp_hbm_counter *c)
+{
+    u32 before[5], after[5];
+    unsigned int i;
+
+    for (i = 0; i < 5U; i++)
+        before[i] = readl(bar + cmp_hbm_counter_addr[i] + slot * 4U);
+    c->count = readl(bar + 0x0010bf80U + slot * 4U);
+    c->delta = 0U;
+    for (i = 0; i < 5U; i++)
+        after[i] = readl(bar + cmp_hbm_counter_addr[i] + slot * 4U);
+    if (memcmp(before, after, sizeof(before)) != 0 || after[3] != 2U ||
+        (after[4] & ~CMP_HBM_COUNT_MASK) != 0U ||
+        (c->count & ~CMP_HBM_COUNT_MASK) != 0U)
+    {
+        cmp_hbm_problem(hbm, -EAGAIN, "activity counter unavailable",
+                        cmp_hbm_counter_addr[3] + slot * 4U, after[3]);
+        return false;
+    }
+    memcpy(c->mask, after, sizeof(c->mask));
+    c->control = after[3];
+    c->threshold = after[4];
+    return true;
+}
+
+static bool cmp_hbm_discover_counters(struct cmp_hbm *hbm, void __iomem *bar)
+{
+    u32 *covered = hbm->coverage;
+    unsigned int i, bank;
+
+    hbm->counters = 0U;
+    memset(covered, 0, sizeof(hbm->coverage));
+    for (i = 0; i < 16U; i++)
+    {
+        struct cmp_hbm_counter c;
+        bool useful = false;
+
+        if (!cmp_hbm_read_counter(hbm, bar, i, &c))
+            continue;
+        for (bank = 0; bank < 3U; bank++)
+        {
+            if (c.mask[bank] & cmp_hbm_required[bank] & ~covered[bank])
+                useful = true;
+        }
+        if (!useful)
+            continue;
+        hbm->counter[i] = c;
+        hbm->counters |= (u16)(1U << i);
+        for (bank = 0; bank < 3U; bank++)
+            covered[bank] |= c.mask[bank];
+    }
+    for (bank = 0; bank < 3U; bank++)
+    {
+        if ((covered[bank] & cmp_hbm_required[bank]) != cmp_hbm_required[bank])
+        {
+            cmp_hbm_problem(hbm, -EAGAIN, "activity counter coverage missing",
+                            cmp_hbm_counter_addr[bank], covered[bank]);
+            return false;
+        }
+    }
+    hbm->reason = NULL;
+    return true;
+}
+
+/*
+ * Pure framebuffer counter (mask0 == 0x80 only, as configured by 615.xx GSP
+ * in slot 1). Any non-zero delta represents real HBM traffic and wakes
+ * immediately; non-FB-only counters (GR/CE or 610.xx combined slots) require
+ * delta >= policy.min_cycles so tiny periodic GSP housekeeping pulses (~2890
+ * cycles every 7.15 s on 615.xx) do not churn the HBM PLL.
+ */
+static bool cmp_hbm_counter_is_fb_only(const struct cmp_hbm_counter *c)
+{
+    return c->mask[0] == CMP_HBM_FB_MASK0 && c->mask[1] == 0U && c->mask[2] == 0U;
+}
+
+static int cmp_hbm_poll(struct cmp_hbm *hbm, void __iomem *bar, u64 now)
+{
+    bool busy = false;
+    u32 min_cycles = (hbm->policy.min_cycles >= 1U) ? hbm->policy.min_cycles : 1U;
+    unsigned int i;
+    int ret;
+
+    hbm->reason = NULL;
+    hbm->active_counters = 0U;
+    hbm->max_delta = 0U;
+    if (!cmp_hbm_booted(bar))
+    {
+        u32 boot = readl(bar + CMP_HBM_GFW_BOOT);
+
+        cmp_hbm_reset(hbm);
+        if (!cmp_hbm_readable(boot) || (boot & 0xffU) != 0xffU)
+            return cmp_hbm_problem(hbm, -EAGAIN, "waiting for GFW boot",
+                                   CMP_HBM_GFW_BOOT, boot);
+        return cmp_hbm_problem(hbm, -EAGAIN, "waiting for GFW/GSP boot",
+                               CMP_HBM_GSP_RISCV_STATUS,
+                               readl(bar + CMP_HBM_GSP_RISCV_STATUS));
+    }
+    if (!hbm->profile)
+    {
+        ret = cmp_hbm_capture_profile(hbm, bar);
+        if (ret)
+            return ret;
+    }
+    if (hbm->policy.mode == CMP_HBM_BUSY)
+        return cmp_hbm_restore(hbm, bar);
+    if (hbm->policy.mode == CMP_HBM_IDLE)
+    {
+        if (!hbm->baseline)
+        {
+            ret = cmp_hbm_restore(hbm, bar);
+            if (ret)
+                return ret;
+        }
+        ret = hbm->idle ? 0 : cmp_hbm_enter_idle(hbm, bar);
+        hbm->baseline = !ret;
+        return ret;
+    }
+    if (!hbm->baseline)
+    {
+        ret = cmp_hbm_restore(hbm, bar);
+        if (ret)
+            return ret;
+        if (!cmp_hbm_discover_counters(hbm, bar))
+            return -EAGAIN;
+        hbm->baseline = true;
+        hbm->sampled = hbm->quiet_since = now;
+        return 0;
+    }
+    if (now < hbm->sampled || (now - hbm->sampled) > CMP_HBM_MAX_SAMPLE_NS)
+    {
+        cmp_hbm_problem(hbm, -EAGAIN, "activity sample gap", 0U, 0U);
+        goto unknown;
+    }
+    for (i = 0; i < 16U; i++)
+    {
+        struct cmp_hbm_counter c;
+        struct cmp_hbm_counter *previous = &hbm->counter[i];
+
+        if (!(hbm->counters & (1U << i)))
+            continue;
+        if (!cmp_hbm_read_counter(hbm, bar, i, &c))
+            goto unknown;
+        if (memcmp(c.mask, previous->mask, sizeof(c.mask)) != 0 ||
+            c.control != previous->control || c.threshold != previous->threshold)
+        {
+            cmp_hbm_problem(hbm, -EAGAIN, "activity counter configuration changed",
+                            cmp_hbm_counter_addr[0] + i * 4U, c.mask[0]);
+            goto unknown;
+        }
+        c.delta = (c.count - previous->count) & CMP_HBM_COUNT_MASK;
+        if (c.delta > hbm->max_delta)
+            hbm->max_delta = c.delta;
+        if (c.delta != 0U)
+        {
+            u32 threshold = cmp_hbm_counter_is_fb_only(&c) ? 1U : min_cycles;
+
+            if (c.delta >= threshold)
+            {
+                hbm->active_counters |= (u16)(1U << i);
+                busy = true;
+            }
+        }
+        *previous = c;
+    }
+    hbm->sampled = now;
+    if (busy)
+    {
+        hbm->quiet_since = now;
+        return cmp_hbm_restore(hbm, bar);
+    }
+    if (!hbm->idle && (now - hbm->quiet_since) >= ((u64)hbm->policy.idle_ms * 1000000ULL))
+        return cmp_hbm_enter_idle(hbm, bar);
+    return 0;
+
+unknown:
+    hbm->baseline = false;
+    ret = cmp_hbm_restore(hbm, bar);
+    return ret ? ret : -EAGAIN;
+}
+
+#ifdef __KERNEL__
+
+static int cmp_hbm_min_cycles = (int)CMP_HBM_DEFAULT_MIN_CYCLES;
+module_param(cmp_hbm_min_cycles, int, 0644);
+MODULE_PARM_DESC(cmp_hbm_min_cycles,
+    "CMP 170HX: minimum non-FB-only PMU counter delta cycles per 20ms poll to wake HBM (default: 8192; 1=strict any non-zero)");
+
+static u32 cmp170hx_get_hbm_min_cycles(void)
+{
+    int val = READ_ONCE(cmp_hbm_min_cycles);
+
+    return (val <= 1) ? 1U : (u32)val;
+}
+
+struct cmp_hbm_worker {
+    struct list_head node;
+    struct pci_dev *pdev;
+    void __iomem *bar;
+    struct mutex lock;
+    struct cmp_hbm hbm;
+    struct delayed_work work;
+    struct notifier_block pm_nb;
+    bool paused, stopping, pm_registered;
+    const char *last_reason;
+    int last_error;
+    u64 last_report;
+};
+
+static LIST_HEAD(cmp_hbm_workers);
+static DEFINE_MUTEX(cmp_hbm_list_lock);
+
+static int cmp_hbm_pm_active(struct pci_dev *pdev)
+{
+#ifdef CMP_PM_ACTIVE_HAS_IGNORE
+    return pm_runtime_get_if_active(&pdev->dev, true);
+#else
+    return pm_runtime_get_if_active(&pdev->dev);
+#endif
+}
+
+static void cmp_hbm_queue(struct cmp_hbm_worker *worker, unsigned long delay)
+{
+    if (!READ_ONCE(worker->paused) && !READ_ONCE(worker->stopping))
+        mod_delayed_work(system_freezable_wq, &worker->work, delay);
+}
+
+static int cmp_hbm_begin(struct cmp_hbm_worker *worker)
+{
+    struct pci_dev *pdev = worker->pdev;
+    u16 command = 0, lnksta = 0;
+    int pm;
+
+    if (pdev->current_state != PCI_D0)
+        return -ENODEV;
+    pm = cmp_hbm_pm_active(pdev);
+    if (!pm)
+        return -EAGAIN;
+    if (pci_read_config_word(pdev, PCI_COMMAND, &command) != 0 ||
+        command == 0xffffU || !(command & PCI_COMMAND_MEMORY))
+    {
+        if (pm > 0)
+            pm_runtime_put(&pdev->dev);
+        return -EAGAIN;
+    }
+    if (pcie_capability_read_word(pdev, PCI_EXP_LNKSTA, &lnksta) == 0 &&
+        (lnksta == 0xffffU || (lnksta & PCI_EXP_LNKSTA_LT) != 0U))
+    {
+        if (pm > 0)
+            pm_runtime_put(&pdev->dev);
+        return -EAGAIN;
+    }
+    return pm > 0;
+}
+
+static void cmp_hbm_end(struct cmp_hbm_worker *worker, int pm)
+{
+    if (pm > 0)
+        pm_runtime_put(&worker->pdev->dev);
+}
+
+static void cmp_hbm_sample(struct cmp_hbm_worker *worker)
+{
+    struct cmp_hbm *hbm = &worker->hbm;
+    bool was_profile = hbm->profile;
+    bool was_idle = hbm->idle;
+    u64 start = ktime_get_ns();
+    int ret;
+
+    hbm->policy.min_cycles = cmp170hx_get_hbm_min_cycles();
+    ret = cmp_hbm_poll(hbm, worker->bar, start);
+    if (!was_profile && hbm->profile)
+    {
+        u32 coeff = hbm->busy_coeff;
+        u32 mdiv = coeff & 0xffU;
+        u32 ndiv = (coeff >> 8) & 0xffU;
+        u32 pldiv = (coeff >> 16) & 0x3fU;
+        u32 mhz = (mdiv && pldiv) ? (27U * ndiv / mdiv / pldiv) : 0U;
+
+        dev_info(&worker->pdev->dev,
+                 "CMP HBM: captured busy profile %u MHz coeff=0x%x idle_coeff=0x%x fbpas=0x%x first=0x%x\n",
+                 mhz, coeff, hbm->idle_coeff, hbm->fbpas, hbm->first_fbpa);
+    }
+    if (was_idle != hbm->idle)
+    {
+        u64 elapsed_us = (ktime_get_ns() - start) / 1000ULL;
+        dev_dbg(&worker->pdev->dev,
+                "CMP HBM: %s -> %s coeff=0x%x active=0x%x max_delta=%u elapsed_us=%llu\n",
+                was_idle ? "idle" : "busy", hbm->idle ? "idle" : "busy",
+                readl(worker->bar + hbm->first_fbpa + CMP_HBM_PLL_COEFF),
+                hbm->active_counters, hbm->max_delta,
+                (unsigned long long)elapsed_us);
+    }
+    if (ret)
+    {
+        if (ret != worker->last_error || hbm->reason != worker->last_reason ||
+            (ret != -EAGAIN && (start - worker->last_report) >= 5000000000ULL))
+        {
+            if (ret != -EAGAIN)
+            {
+                dev_warn(&worker->pdev->dev,
+                         "CMP HBM: %s (%d) reg=0x%x value=0x%x busy_coeff=0x%x idle_coeff=0x%x idle=%u fb_stopped=%u\n",
+                         hbm->reason ? hbm->reason : "hardware unavailable", ret,
+                         hbm->reg, hbm->value, hbm->busy_coeff, hbm->idle_coeff,
+                         hbm->idle ? 1U : 0U, hbm->fb_stopped ? 1U : 0U);
+            }
+            worker->last_report = start;
+        }
+    }
+    else if (worker->last_error || !worker->last_report)
+    {
+        worker->last_report = start;
+    }
+    worker->last_error = ret;
+    worker->last_reason = hbm->reason;
+}
+
+static void cmp_hbm_poll_work(struct work_struct *work)
+{
+    struct cmp_hbm_worker *worker = container_of(work, struct cmp_hbm_worker, work.work);
+    unsigned int delay = CMP_HBM_POLL_MS;
+    int pm;
+
+    if (READ_ONCE(worker->paused) || READ_ONCE(worker->stopping))
+        return;
+
+    if (mutex_trylock(&worker->lock))
+    {
+        if (!READ_ONCE(worker->paused) && !READ_ONCE(worker->stopping))
+        {
+            pm = cmp_hbm_begin(worker);
+            if (pm >= 0)
+            {
+                cmp_hbm_sample(worker);
+                if (worker->last_error && worker->last_error != -EAGAIN)
+                    delay = CMP_HBM_RETRY_MS;
+                cmp_hbm_end(worker, pm);
+            }
+            else
+            {
+                cmp_hbm_reset(&worker->hbm);
+            }
+        }
+        mutex_unlock(&worker->lock);
+    }
+    cmp_hbm_queue(worker, msecs_to_jiffies(delay));
+}
+
+static void cmp_hbm_restore_locked(struct cmp_hbm_worker *worker)
+{
+    int pm = cmp_hbm_begin(worker);
+
+    if (pm >= 0)
+    {
+        bool was_idle = worker->hbm.idle;
+        int ret = cmp_hbm_restore(&worker->hbm, worker->bar);
+
+        if (ret)
+        {
+            dev_warn(&worker->pdev->dev,
+                     "CMP HBM: busy restore deferred (%d) %s reg=0x%x value=0x%x\n",
+                     ret, worker->hbm.reason ? worker->hbm.reason : "hardware unavailable",
+                     worker->hbm.reg, worker->hbm.value);
+        }
+        else if (was_idle)
+        {
+            dev_info(&worker->pdev->dev,
+                     "CMP HBM: busy profile restored for detach/sleep\n");
+        }
+        cmp_hbm_end(worker, pm);
+    }
+    else if (worker->hbm.idle)
+    {
+        dev_warn(&worker->pdev->dev,
+                 "CMP HBM: busy restore deferred: PCI device inactive (%d)\n", pm);
+    }
+    cmp_hbm_reset(&worker->hbm);
+}
+
+static int cmp_hbm_pm_notify(struct notifier_block *nb, unsigned long event, void *unused)
+{
+    struct cmp_hbm_worker *worker = container_of(nb, struct cmp_hbm_worker, pm_nb);
+
+    (void)unused;
+    switch (event)
+    {
+    case PM_SUSPEND_PREPARE:
+    case PM_HIBERNATION_PREPARE:
+    case PM_RESTORE_PREPARE:
+        WRITE_ONCE(worker->paused, true);
+        cancel_delayed_work_sync(&worker->work);
+        mutex_lock(&worker->lock);
+        cmp_hbm_restore_locked(worker);
+        mutex_unlock(&worker->lock);
+        break;
+    case PM_POST_SUSPEND:
+    case PM_POST_HIBERNATION:
+    case PM_POST_RESTORE:
+        mutex_lock(&worker->lock);
+        cmp_hbm_reset(&worker->hbm);
+        mutex_unlock(&worker->lock);
+        WRITE_ONCE(worker->paused, false);
+        cmp_hbm_queue(worker, 0);
+        break;
+    default:
+        break;
+    }
+    return NOTIFY_DONE;
+}
+
+static void cmp_hbm_worker_start(struct pci_dev *pdev)
+{
+    struct cmp_hbm_worker *worker;
+    unsigned int domain, bus, slot, fn;
+    u32 idle_ms;
+    int ret;
+
+    if (pdev == NULL || (pdev->device != 0x20C2 && pdev->device != 0x2082))
+        return;
+
+    domain = (unsigned int)pci_domain_nr(pdev->bus);
+    bus    = (unsigned int)pdev->bus->number;
+    slot   = (unsigned int)PCI_SLOT(pdev->devfn);
+    fn     = (unsigned int)PCI_FUNC(pdev->devfn);
+
+    if (!cmp170hx_want_hbm_governor(domain, bus, slot, fn))
+        return;
+
+    if (pci_resource_len(pdev, 0) < 0x00a00000ULL)
+    {
+        dev_warn(&pdev->dev, "CMP HBM: BAR0 too small for HBM governor\n");
+        return;
+    }
+
+    worker = kzalloc(sizeof(*worker), GFP_KERNEL);
+    if (!worker)
+        return;
+
+    idle_ms = cmp170hx_get_hbm_idle_ms();
+    cmp_hbm_init(&worker->hbm, idle_ms);
+    worker->hbm.policy.min_cycles = cmp170hx_get_hbm_min_cycles();
+    worker->pdev = pdev;
+    mutex_init(&worker->lock);
+    INIT_DELAYED_WORK(&worker->work, cmp_hbm_poll_work);
+    worker->pm_nb.notifier_call = cmp_hbm_pm_notify;
+    /* Quiesce at the start of Linux's sleep notification chain before GPU suspend. */
+    worker->pm_nb.priority = INT_MAX;
+
+    worker->bar = pci_iomap_range(pdev, 0, 0, 0x00a00000UL);
+    if (!worker->bar)
+    {
+        dev_warn(&pdev->dev, "CMP HBM: failed to map BAR0 for HBM governor\n");
+        kfree(worker);
+        return;
+    }
+
+    ret = register_pm_notifier(&worker->pm_nb);
+    if (ret)
+    {
+        dev_warn(&pdev->dev, "CMP HBM: failed to register PM notifier (%d)\n", ret);
+        pci_iounmap(pdev, worker->bar);
+        kfree(worker);
+        return;
+    }
+    worker->pm_registered = true;
+
+    mutex_lock(&cmp_hbm_list_lock);
+    list_add_tail(&worker->node, &cmp_hbm_workers);
+    mutex_unlock(&cmp_hbm_list_lock);
+
+    dev_info(&pdev->dev,
+             "CMP HBM: governor registered idle_ms=%u min_cycles=%u poll_ms=%u idle_ndiv=%u idle_pldiv=%u idle_refresh=%u transition=stop_machine/fb-stop/bypass\n",
+             worker->hbm.policy.idle_ms, worker->hbm.policy.min_cycles,
+             CMP_HBM_POLL_MS, CMP_HBM_IDLE_NDIV, CMP_HBM_IDLE_PLDIV,
+             CMP_HBM_IDLE_REFRESH);
+    cmp_hbm_queue(worker, 0);
+}
+
+static void cmp_hbm_worker_stop(struct pci_dev *pdev)
+{
+    struct cmp_hbm_worker *worker = NULL, *cur;
+
+    if (pdev == NULL)
+        return;
+
+    mutex_lock(&cmp_hbm_list_lock);
+    list_for_each_entry(cur, &cmp_hbm_workers, node)
+    {
+        if (cur->pdev == pdev)
+        {
+            list_del(&cur->node);
+            worker = cur;
+            break;
+        }
+    }
+    mutex_unlock(&cmp_hbm_list_lock);
+
+    if (!worker)
+        return;
+
+    WRITE_ONCE(worker->stopping, true);
+    if (worker->pm_registered)
+        unregister_pm_notifier(&worker->pm_nb);
+    cancel_delayed_work_sync(&worker->work);
+    mutex_lock(&worker->lock);
+    cmp_hbm_restore_locked(worker);
+    mutex_unlock(&worker->lock);
+    pci_iounmap(pdev, worker->bar);
+    kfree(worker);
+}
+
+#endif /* __KERNEL__ */
+
+#endif /* NV_CMP_HBM_H */
