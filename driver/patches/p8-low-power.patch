diff --git a/src/nvidia/src/kernel/gpu/gsp/nv_cmp_p8_vbios.h b/src/nvidia/src/kernel/gpu/gsp/nv_cmp_p8_vbios.h
new file mode 100644
index 0000000..e6f64f6
--- /dev/null
+++ b/src/nvidia/src/kernel/gpu/gsp/nv_cmp_p8_vbios.h
@@ -0,0 +1,434 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * GA100 / CMP 170HX P8 VBIOS override generator.
+ *
+ * Ported from Zagitta/gpu-unlock (kernel/gpu_unlock/vbios.c):
+ * Synthesizes a P8 (pstate 7) row in empty slot 0 of the GA100 Performance
+ * 0x60 table by cloning factory P0 (pstate 15), lowering only the minimum
+ * clock floors of GPC, XBAR, SYS, NVD, and HOST to minimum_mhz (default 135
+ * MHz), preserving voltage policy, HBM tuple, and factory P0, and emitting
+ * NVIDIA romOverride binary records (75-byte row + 11-byte ROM checksum).
+ */
+#ifndef NV_CMP_P8_VBIOS_H
+#define NV_CMP_P8_VBIOS_H
+
+#ifdef CMP_P8_HOST_TEST
+#include <stddef.h>
+#include <stdint.h>
+typedef uint8_t  cmp_u8;
+typedef uint16_t cmp_u16;
+typedef uint32_t cmp_u32;
+typedef uint64_t cmp_u64;
+#else
+typedef NvU8  cmp_u8;
+typedef NvU16 cmp_u16;
+typedef NvU32 cmp_u32;
+typedef NvU64 cmp_u64;
+#endif
+
+#define CMP_P8_OK          0
+#define CMP_P8_ERR_ALREADY 1
+#define CMP_P8_ERR_INVAL   (-1)
+#define CMP_P8_ERR_UNSUP   (-2)
+#define CMP_P8_ERR_BADMSG  (-3)
+#define CMP_P8_ERR_NOENT   (-4)
+
+#define CMP_P8_RECORD_SIZE   75U
+#define CMP_P8_CHECKSUM_SIZE 11U
+#define CMP_P8_DEFAULT_MIN_MHZ 135U
+
+static cmp_u16 cmp_p8_r16(const cmp_u8 *p)
+{
+    return (cmp_u16)((cmp_u16)p[0] | ((cmp_u16)p[1] << 8));
+}
+
+static cmp_u32 cmp_p8_r32(const cmp_u8 *p)
+{
+    return (cmp_u32)p[0] | ((cmp_u32)p[1] << 8) |
+           ((cmp_u32)p[2] << 16) | ((cmp_u32)p[3] << 24);
+}
+
+static void cmp_p8_w32(cmp_u8 *p, cmp_u32 value)
+{
+    p[0] = (cmp_u8)(value & 0xffU);
+    p[1] = (cmp_u8)((value >> 8) & 0xffU);
+    p[2] = (cmp_u8)((value >> 16) & 0xffU);
+    p[3] = (cmp_u8)((value >> 24) & 0xffU);
+}
+
+static void cmp_p8_memcpy(cmp_u8 *dst, const cmp_u8 *src, cmp_u32 len)
+{
+    cmp_u32 i;
+    for (i = 0; i < len; i++)
+        dst[i] = src[i];
+}
+
+static int cmp_p8_memeq(const cmp_u8 *a, const cmp_u8 *b, cmp_u32 len)
+{
+    cmp_u32 i;
+    for (i = 0; i < len; i++)
+    {
+        if (a[i] != b[i])
+            return 0;
+    }
+    return 1;
+}
+
+static int cmp_p8_range(cmp_u64 length, cmp_u64 off, cmp_u64 bytes)
+{
+    return (off > length || bytes > length - off) ? CMP_P8_ERR_INVAL : CMP_P8_OK;
+}
+
+static int cmp_p8_rom_signature(cmp_u16 sig)
+{
+    return sig == 0xaa55U || sig == 0x4e56U || sig == 0xbb77U;
+}
+
+static int cmp_p8_data_signature(cmp_u32 sig)
+{
+    return sig == 0x52494350U || sig == 0x5344504eU || sig == 0x53494752U;
+}
+
+static int cmp_p8_pci_image(const cmp_u8 *rom, cmp_u64 length, cmp_u32 *offset)
+{
+    cmp_u32 image = 0;
+
+    if (length >= 12U && cmp_p8_r32(rom) == 0x4947564eU)
+    {
+        cmp_u32 version = (cmp_p8_r32(rom + 4) >> 8) & 0xffU;
+        cmp_u32 total, flash;
+        cmp_u64 dir;
+
+        if (version != 3U)
+            return CMP_P8_ERR_UNSUP;
+        total = cmp_p8_r32(rom + 8) & 0xfffffU;
+        if (cmp_p8_range(length, total, 4U) != CMP_P8_OK)
+            return CMP_P8_ERR_INVAL;
+        flash = cmp_p8_r32(rom + total);
+        dir = (cmp_u64)flash + 0x1000U;
+        if (cmp_p8_range(length, dir, 12U) != CMP_P8_OK ||
+            cmp_p8_r32(rom + dir) != 0x44524652U)
+            return CMP_P8_ERR_INVAL;
+        image = cmp_p8_r32(rom + dir + 8);
+        if (image == 0U || (image & 3U) != 0U ||
+            cmp_p8_range(length, image, 2U) != CMP_P8_OK ||
+            cmp_p8_r16(rom + image) != 0xaa55U)
+            return CMP_P8_ERR_INVAL;
+    }
+    *offset = image;
+    return CMP_P8_OK;
+}
+
+static int cmp_p8_expansion(const cmp_u8 *rom, cmp_u64 length, cmp_u32 *adjust)
+{
+    cmp_u32 pos = 0, base = 0, ext = 0;
+    unsigned int images = 0;
+
+    if (cmp_p8_range(length, 0, 2U) != CMP_P8_OK || !cmp_p8_rom_signature(cmp_p8_r16(rom)))
+        return CMP_P8_ERR_INVAL;
+
+    for (;;)
+    {
+        cmp_u64 pcir, npde;
+        cmp_u32 bytes, last, sig;
+        cmp_u16 ext_rev, ext_len;
+
+        if (++images > 8U || cmp_p8_range(length, pos, 0x1aU) != CMP_P8_OK ||
+            !cmp_p8_rom_signature(cmp_p8_r16(rom + pos)))
+            return CMP_P8_ERR_INVAL;
+
+        pcir = (cmp_u64)pos + cmp_p8_r16(rom + pos + 0x18);
+        if (cmp_p8_range(length, pcir, 0x16U) != CMP_P8_OK)
+            return CMP_P8_ERR_INVAL;
+
+        sig = cmp_p8_r32(rom + pcir);
+        if (!cmp_p8_data_signature(sig))
+            return CMP_P8_ERR_INVAL;
+
+        bytes = (cmp_u32)cmp_p8_r16(rom + pcir + 0x10) * 512U;
+        last = rom[pcir + 0x15] & 0x80U;
+        npde = (pcir + cmp_p8_r16(rom + pcir + 0x0a) + 15U) & ~(cmp_u64)15U;
+        if (cmp_p8_range(length, npde, 4U) == CMP_P8_OK &&
+            cmp_p8_r32(rom + npde) == 0x4544504eU)
+        {
+            if (cmp_p8_range(length, npde, 10U) != CMP_P8_OK)
+                return CMP_P8_ERR_INVAL;
+            ext_rev = cmp_p8_r16(rom + npde + 4);
+            ext_len = cmp_p8_r16(rom + npde + 6);
+            if (ext_rev == 0x100U || ext_rev == 0x101U)
+            {
+                cmp_u32 sub = (cmp_u32)cmp_p8_r16(rom + npde + 8) * 512U;
+                if (ext_len < 10U || cmp_p8_range(length, npde, ext_len) != CMP_P8_OK)
+                    return CMP_P8_ERR_INVAL;
+                if (ext_len > 10U)
+                    last = rom[npde + 10] & 0x80U;
+                else if (sub < bytes)
+                    last = 0U;
+                bytes = sub;
+            }
+        }
+        if (bytes == 0U || cmp_p8_range(length, pos, bytes) != CMP_P8_OK)
+            return CMP_P8_ERR_INVAL;
+        if (base == 0U && rom[pcir + 0x14] == 0U)
+            base = bytes;
+        if (ext == 0U && rom[pcir + 0x14] == 0xe0U)
+            ext = pos;
+        if (last != 0U)
+            break;
+        pos += bytes;
+    }
+
+    if (ext != 0U && base != 0U && ext < base)
+        return CMP_P8_ERR_INVAL;
+    *adjust = (ext != 0U && base != 0U) ? (ext - base) : 0U;
+    return CMP_P8_OK;
+}
+
+typedef struct cmp_p8_image {
+    const cmp_u8 *rom;
+    cmp_u64 length;
+    cmp_u32 adjust;
+    cmp_u32 token;
+    cmp_u8 version[5];
+} cmp_p8_image_t;
+
+static int cmp_p8_find_image(const cmp_u8 *rom, cmp_u64 length, cmp_u8 kind,
+                             cmp_u32 minimum, cmp_p8_image_t *out)
+{
+    cmp_u32 image = 0, adjust = 0, pcir, bit, legacy, bios = 0, data = 0;
+    int found = 0;
+    int ret;
+
+    if (rom == NULL || length > (1024U * 1024U))
+        return CMP_P8_ERR_INVAL;
+
+    ret = cmp_p8_pci_image(rom, length, &image);
+    if (ret != CMP_P8_OK)
+        return ret;
+    rom += image;
+    length -= image;
+
+    ret = cmp_p8_expansion(rom, length, &adjust);
+    if (ret != CMP_P8_OK)
+        return ret;
+    if (cmp_p8_range(length, 0, 0x1aU) != CMP_P8_OK)
+        return CMP_P8_ERR_INVAL;
+
+    pcir = cmp_p8_r16(rom + 0x18);
+    if (cmp_p8_range(length, pcir, 0x16U) != CMP_P8_OK ||
+        cmp_p8_r16(rom) != 0xaa55U ||
+        cmp_p8_r32(rom + pcir) != 0x52494350U ||
+        cmp_p8_r16(rom + pcir + 4) != 0x10deU ||
+        rom[pcir + 0x14] != 0U)
+        return CMP_P8_ERR_UNSUP;
+
+    if (cmp_p8_r16(rom + pcir + 0x10) == 0U ||
+        cmp_p8_range(length, 0, (cmp_u64)cmp_p8_r16(rom + pcir + 0x10) * 512U) != CMP_P8_OK)
+        return CMP_P8_ERR_INVAL;
+
+    legacy = (cmp_u32)cmp_p8_r16(rom + pcir + 0x10) * 512U;
+    for (bit = 0; bit + 12U <= legacy; bit++)
+    {
+        cmp_u32 header, stride, count, sum = 0, i, b = 0, in = 0;
+
+        if (cmp_p8_r16(rom + bit) != 0xb8ffU || cmp_p8_r32(rom + bit + 2) != 0x00544942U)
+            continue;
+        header = rom[bit + 8];
+        stride = rom[bit + 9];
+        count  = rom[bit + 10];
+        if (cmp_p8_r16(rom + bit + 6) != 0x100U || header < 12U ||
+            (stride != 6U && stride != 8U) ||
+            cmp_p8_range(legacy, bit, header) != CMP_P8_OK ||
+            cmp_p8_range(legacy, (cmp_u64)bit + header, (cmp_u64)count * stride) != CMP_P8_OK)
+            return CMP_P8_ERR_BADMSG;
+        for (i = 0; i < header; i++)
+            sum += rom[bit + i];
+        if ((sum & 0xffU) != 0U)
+            return CMP_P8_ERR_BADMSG;
+        for (i = 0; i < count; i++)
+        {
+            const cmp_u8 *token = rom + bit + header + i * stride;
+            cmp_u32 ptr = (stride == 8U) ? cmp_p8_r32(token + 4) : cmp_p8_r16(token + 4);
+
+            if (token[0] != (cmp_u8)'B' && token[0] != kind)
+                continue;
+            if (token[1] != 2U || cmp_p8_range(legacy, ptr, cmp_p8_r16(token + 2)) != CMP_P8_OK || ptr == 0U)
+                return CMP_P8_ERR_UNSUP;
+            if (token[0] == (cmp_u8)'B')
+            {
+                if (b != 0U || cmp_p8_r16(token + 2) < 5U)
+                    return CMP_P8_ERR_BADMSG;
+                b = ptr;
+            }
+            else
+            {
+                if (in != 0U || cmp_p8_r16(token + 2) < minimum)
+                    return CMP_P8_ERR_BADMSG;
+                in = ptr;
+            }
+        }
+        if (b == 0U || in == 0U || found != 0)
+            return CMP_P8_ERR_BADMSG;
+        bios = b;
+        data = in;
+        found = 1;
+    }
+    if (!found)
+        return CMP_P8_ERR_NOENT;
+
+    /* Zero is a wildcard in NVIDIA's version guards; never emit one. */
+    if (cmp_p8_r32(rom + bios) == 0U || rom[bios + 4] == 0U)
+        return CMP_P8_ERR_UNSUP;
+
+    out->rom = rom;
+    out->length = length;
+    out->adjust = adjust;
+    out->token = data;
+    out->version[0] = rom[bios + 3];
+    out->version[1] = rom[bios + 2];
+    out->version[2] = rom[bios + 1];
+    out->version[3] = rom[bios];
+    out->version[4] = rom[bios + 4];
+    return CMP_P8_OK;
+}
+
+static void cmp_p8_emit_record(const cmp_p8_image_t *image, cmp_u32 offset,
+                               const cmp_u8 *data, cmp_u8 size, cmp_u8 *record)
+{
+    cmp_p8_memcpy(record, image->version, 5U);
+    cmp_p8_w32(record + 5, offset);
+    record[9] = size;
+    cmp_p8_memcpy(record + 10, data, size);
+}
+
+static const cmp_u8 *cmp_p8_table(const cmp_p8_image_t *image, cmp_u32 pointer, cmp_u32 bytes)
+{
+    cmp_u32 offset = cmp_p8_r32(image->rom + image->token + pointer);
+
+    if (offset == 0U || offset > (~(cmp_u32)0U - image->adjust))
+        return NULL;
+    offset += image->adjust;
+    return (cmp_p8_range(image->length, offset, bytes) != CMP_P8_OK) ? NULL : (image->rom + offset);
+}
+
+/*
+ * Find the PCI/NPDS image owning the entire edit, including its trailing
+ * checksum byte, verify its existing 8-bit sum is 0, and emit the checksum fix.
+ */
+static int cmp_p8_checksum_record(const cmp_p8_image_t *image, cmp_u32 offset,
+                                  const cmp_u8 *data, cmp_u8 size, cmp_u8 record[CMP_P8_CHECKSUM_SIZE])
+{
+    const cmp_u8 *rom = image->rom;
+    cmp_u32 pos, pcir, bytes, sum, i;
+    cmp_u8 checksum;
+
+    for (pos = 0; pos <= offset; pos += 512U)
+    {
+        if (cmp_p8_range(image->length, pos, 0x1aU) != CMP_P8_OK ||
+            !cmp_p8_rom_signature(cmp_p8_r16(rom + pos)))
+            continue;
+        pcir = pos + cmp_p8_r16(rom + pos + 0x18);
+        if (cmp_p8_range(image->length, pcir, 0x16U) != CMP_P8_OK ||
+            !cmp_p8_data_signature(cmp_p8_r32(rom + pcir)))
+            continue;
+        bytes = (cmp_u32)cmp_p8_r16(rom + pcir + 0x10) * 512U;
+        if (bytes == 0U || cmp_p8_range(image->length, pos, bytes) != CMP_P8_OK ||
+            offset < pos || cmp_p8_range(bytes - 1U, offset - pos, size) != CMP_P8_OK)
+            continue;
+        sum = 0U;
+        for (i = 0; i < bytes; i++)
+            sum = (sum + rom[pos + i]) & 0xffU;
+        if (sum != 0U)
+            return CMP_P8_ERR_BADMSG;
+        for (i = 0; i < size; i++)
+            sum = (sum + data[i] + 256U - rom[offset + i]) & 0xffU;
+        checksum = (cmp_u8)((rom[pos + bytes - 1U] + 256U - sum) & 0xffU);
+        cmp_p8_emit_record(image, pos + bytes - 1U, &checksum, 1U, record);
+        return CMP_P8_OK;
+    }
+    return CMP_P8_ERR_INVAL;
+}
+
+static int cmp_p8_build_overrides(const cmp_u8 *rom, cmp_u64 length, cmp_u16 minimum_mhz,
+                                  cmp_u8 record[CMP_P8_RECORD_SIZE],
+                                  cmp_u8 checksum[CMP_P8_CHECKSUM_SIZE])
+{
+    static const cmp_u8 domains[] = { 0U, 1U, 3U, 5U, 9U }; /* GPC, XBAR, SYS, NVD, HOST */
+    static const cmp_u8 p0_hdr_a[5] = { 0x0fU, 0x08U, 0x03U, 0x00U, 0x00U };
+    static const cmp_u8 p0_hdr_b[5] = { 0x0fU, 0x08U, 0x03U, 0xffU, 0x00U };
+    cmp_p8_image_t image;
+    const cmp_u8 *table;
+    cmp_u32 offset, entry, p0 = 0U, empty = 0U, i;
+    cmp_u8 row[65];
+    int ret;
+
+    if (record == NULL || checksum == NULL || minimum_mhz == 0U || minimum_mhz > 0x3fffU)
+        return CMP_P8_ERR_INVAL;
+
+    ret = cmp_p8_find_image(rom, length, (cmp_u8)'P', 4U, &image);
+    if (ret != CMP_P8_OK)
+        return ret;
+
+    table = cmp_p8_table(&image, 0U, 10U);
+    if (table == NULL)
+        return CMP_P8_ERR_INVAL;
+
+    offset = (cmp_u32)(table - image.rom);
+    /* Only the audited GA100 Performance 0x60 layout is supported. */
+    if (table[0] != 0x60U || table[1] != 10U || table[2] != 5U ||
+        table[3] == 0U || table[4] != 6U || table[5] != 10U ||
+        cmp_p8_range(image.length, (cmp_u64)offset + 10U, (cmp_u64)table[3] * sizeof(row)) != CMP_P8_OK)
+        return CMP_P8_ERR_UNSUP;
+
+    for (i = 0; i < table[3]; i++)
+    {
+        entry = offset + 10U + i * (cmp_u32)sizeof(row);
+        if (image.rom[entry] == 7U)
+            return CMP_P8_ERR_ALREADY; /* Keep a factory P8 intact. */
+        if (image.rom[entry] == 0xffU && empty == 0U)
+            empty = entry;
+        if (image.rom[entry] == 15U)
+        {
+            if (p0 != 0U)
+                return CMP_P8_ERR_BADMSG;
+            p0 = entry;
+        }
+    }
+
+    /*
+     * RM's idle limit uses insertion level zero, so do not put P8 after an
+     * existing state or reorder the factory entries.
+     */
+    if (p0 == 0U || empty != (offset + 10U) ||
+        (!cmp_p8_memeq(image.rom + p0, p0_hdr_a, 5U) &&
+         !cmp_p8_memeq(image.rom + p0, p0_hdr_b, 5U)))
+        return CMP_P8_ERR_UNSUP;
+
+    cmp_p8_memcpy(row, image.rom + p0, (cmp_u32)sizeof(row));
+    /* Reuse the tested P0 power/link policies and clock tuples as P8. */
+    row[0] = 7U;
+    /*
+     * Lower only the requested domain minimum clock floors in P8. Voltage
+     * policy, HBM tuple (domain 2), and factory P0 remain untouched.
+     */
+    for (i = 0; i < (cmp_u32)sizeof(domains); i++)
+    {
+        cmp_u8 *tuple = row + 5U + domains[i] * 6U;
+        cmp_u32 limits = cmp_p8_r32(tuple + 2);
+        cmp_u32 cur_min = limits & 0x3fffU;
+
+        if (cur_min == 0U)
+            return CMP_P8_ERR_UNSUP;
+        if (cur_min > minimum_mhz)
+            cmp_p8_w32(tuple + 2, (limits & ~0x3fffU) | (cmp_u32)minimum_mhz);
+    }
+
+    ret = cmp_p8_checksum_record(&image, empty, row, (cmp_u8)sizeof(row), checksum);
+    if (ret != CMP_P8_OK)
+        return ret;
+    cmp_p8_emit_record(&image, empty, row, (cmp_u8)sizeof(row), record);
+    return CMP_P8_OK;
+}
+
+#endif /* NV_CMP_P8_VBIOS_H */
