+static void
+_kgspCmp170hxApplyP8Overrides(OBJGPU *pGpu, const KernelGspVbiosImg *pVbiosImg)
+{
+    NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+    NvU8 existing[266];
+    NvU32 existingLen = (NvU32)sizeof(existing);
+    NvU8 p8Rec[CMP_P8_RECORD_SIZE];
+    NvU8 csumRec[CMP_P8_CHECKSUM_SIZE];
+    NvU16 minMhz;
+    int rc;
+
+    if ((devId != SEC2_POSTBL_TIMING_CMP_170HX_8GB_PCI_DEVICE_ID &&
+         devId != SEC2_POSTBL_TIMING_CMP_170HX_10GB_PCI_DEVICE_ID) ||
+        pVbiosImg == NULL || pVbiosImg->pImage == NULL || pVbiosImg->biosSize == 0U)
+        return;
+
+    if (!cmp170hx_want_p8_vbios(gpuGetDomain(pGpu), gpuGetBus(pGpu), gpuGetDevice(pGpu), 0U))
+        return;
+
+    /* Respect any user-supplied or previously installed romOverride00 entry. */
+    if (osReadRegistryBinary(pGpu, "romOverride00", existing, &existingLen) == NV_OK)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "SEC2_DEBUG: CMP P8: existing romOverride00 present; preserving it\n");
+        return;
+    }
+
+    minMhz = (NvU16)cmp170hx_get_p8_min_mhz();
+    rc = cmp_p8_build_overrides(pVbiosImg->pImage, pVbiosImg->biosSize,
+                                minMhz, p8Rec, csumRec);
+    if (rc == CMP_P8_ERR_ALREADY)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "SEC2_DEBUG: CMP P8: board VBIOS already provides P8\n");
+        return;
+    }
+    if (rc != CMP_P8_OK)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "SEC2_DEBUG: CMP P8: P8 override unavailable for this VBIOS (rc=%d)\n", rc);
+        return;
+    }
+
+    if (osWriteRegistryBinary(pGpu, "romOverride00", p8Rec, (NvU32)sizeof(p8Rec)) != NV_OK ||
+        osWriteRegistryBinary(pGpu, "romOverride01", csumRec, (NvU32)sizeof(csumRec)) != NV_OK)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "SEC2_DEBUG: CMP P8: failed to register romOverride00/01\n");
+        return;
+    }
+
+    NV_PRINTF(LEVEL_ERROR,
+              "SEC2_DEBUG: CMP P8: generated VBIOS override BIOS=%02x.%02x.%02x.%02x.%02x "
+              "p8_off=0x%x csum_off=0x%x min_mhz=%u (factory P0 preserved)\n",
+              p8Rec[0], p8Rec[1], p8Rec[2], p8Rec[3], p8Rec[4],
+              cmp_p8_r32(p8Rec + 5), cmp_p8_r32(csumRec + 5), (unsigned int)minMhz);
+}
 
