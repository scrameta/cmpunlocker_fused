+}
+
+int cmp170hx_want_p8_vbios(unsigned int domain, unsigned int bus,
+                           unsigned int dev, unsigned int fn)
+{
+    if (!cmp170hx_bdf_matches(domain, bus, dev, fn))
+        return 0;
+    if (cmp_p8_vbios >= 0)
+        return (cmp_p8_vbios != 0) ? 1 : 0;
+    return cmp170hx_want_p8_low_power();
+}
+
+int cmp170hx_want_hbm_governor(unsigned int domain, unsigned int bus,
+                               unsigned int dev, unsigned int fn)
+{
+    if (!cmp170hx_bdf_matches(domain, bus, dev, fn))
+        return 0;
+    if (cmp_hbm_governor >= 0)
+        return (cmp_hbm_governor != 0) ? 1 : 0;
+    return cmp170hx_want_p8_low_power();
+}
+
+int cmp170hx_get_p8_min_mhz(void)
+{
+    if (cmp_p8_min_mhz <= 0 || cmp_p8_min_mhz > 0x3fff)
+        return 135;
+    return cmp_p8_min_mhz;
+}
+
+unsigned int cmp170hx_get_hbm_idle_ms(void)
+{
+    if (cmp_hbm_idle_ms < 100)
+        return 5000U;
+    return (unsigned int)cmp_hbm_idle_ms;
+}
